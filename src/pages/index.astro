---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import PackageCard from '../components/PackageCard.astro';
import Checks from '../components/Checks.astro';
import Steps from '../components/Steps.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Button from '../components/Button.astro';
import ArmaTuZona from '../components/ArmaTuZona.astro';
import Incluye from '../components/Incluye.astro';
import Faq from '../components/Faq.astro';
import { paquetes, familias } from '../data/paquetes';
import { site, mxn, whatsappLink } from '../data/site';

const secos = paquetes.filter((p) => !p.splash);
const splash = paquetes.filter((p) => p.splash);
const porFamilia = (lista: typeof paquetes, f: 'baby' | 'terreneitor') => lista.filter((p) => p.familia === f);

const requisitos = [
  { title: 'Zona techada o con sombra', text: 'El sol directo calienta el material y cansa a los niños.' },
  { title: 'Piso plano y libre', text: 'Sin piedras, hormigueros, desniveles ni lodo.' },
  { title: 'Contacto eléctrico cerca', text: 'A menos de diez metros del área de montaje.' },
  { title: 'Lejos de riesgos', text: 'Cocina, asador, alberca y paso de coches.' },
];

const pasos = [
  { title: 'Nos escribes', text: 'Fecha, hora de inicio, dirección y edades de los niños.' },
  { title: 'Te cotizamos', text: 'Confirmamos disponibilidad y el paquete ideal para tu fiesta.' },
  { title: `Apartas con ${mxn(site.bookingDeposit)}`, text: 'Por transferencia. Se descuenta del total.' },
  { title: 'Firmamos contrato', text: `Con copia de INE y depósito de ${mxn(site.guaranteeDeposit)} en garantía.` },
  { title: 'Montamos y recogemos', text: 'Llegamos una hora antes. El depósito se devuelve al terminar.' },
];

const incluye = [
  { icon: 'horario', title: `${site.serviceHours} horas de juego`, text: 'De juego supervisado o libre, según tu paquete.', wide: true },
  { icon: 'casa', title: `${site.spaceNeeded} de zona`, text: 'El espacio que necesitamos en tu casa, jardín o salón.', wide: true },
  { icon: 'fecha-confirmada', title: 'Montaje', text: 'Llegamos una hora antes de la fiesta.' },
  { icon: 'traslado', title: 'Traslado', text: 'Incluido dentro de San Juan del Río.' },
  { icon: 'brillo', title: 'Sanitización', text: 'Pieza por pieza, antes de cada fiesta.' },
  { icon: 'listo', title: 'Desmontaje', text: 'Recogemos todo al terminar.' },
];

const semanas = [
  { title: '4 semanas antes', text: `Define fecha, hora e invitados, y aparta tu zona con ${mxn(site.bookingDeposit)}.` },
  { title: '3 semanas antes', text: 'Manda las invitaciones y pide que confirmen cuántos niños van.' },
  { title: '1 semana antes', text: 'Revisa el espacio: sombra, piso plano y un contacto a menos de diez metros.' },
  { title: 'El día de la fiesta', text: 'Llegamos una hora antes a montar. Tú recibes a tus invitados.' },
];

const faq = [
  { q: '¿En qué zonas dan servicio?', a: `En ${site.areas.join(' y ')}. El traslado dentro de San Juan del Río está incluido; Tequisquiapan y otros municipios se cotizan.` },
  { q: '¿Cuánto espacio necesito?', a: `Un área de ${site.spaceNeeded}, techada o con sombra, con piso plano y un contacto eléctrico a menos de diez metros.` },
  { q: '¿Cuánto dura el servicio?', a: `${site.serviceHours} horas. Llegamos una hora antes a montar y recogemos todo al terminar.` },
  { q: '¿Cómo aparto mi fecha?', a: `Con un anticipo de ${mxn(site.bookingDeposit)} por transferencia, que se descuenta del total. Firmamos contrato con copia de INE y un depósito de ${mxn(site.guaranteeDeposit)} en garantía, que se devuelve al terminar.` },
  { q: '¿Qué hacen las cuidadoras de los paquetes Pro?', a: 'Se quedan toda la fiesta en la zona: cuidan y organizan el juego. Pro Baby lleva dos cuidadoras y Terreneitor Pro, tres. Nunca sacan a un niño del área ni dan alimentos.' },
  { q: '¿El material está limpio?', a: 'Sí. Sanitizamos pieza por pieza antes de cada fiesta.' },
  { q: '¿Y si hay niños de distintas edades?', a: 'Escríbenos por WhatsApp con las edades y te armamos la combinación que mejor funcione.' },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Renta de zonas de juego para fiestas infantiles',
  provider: { '@type': 'LocalBusiness', name: site.name, url: site.url },
  areaServed: site.areas.map((name) => ({ '@type': 'City', name })),
  offers: paquetes.map((p) => ({ '@type': 'Offer', name: p.nombre, price: p.precio, priceCurrency: 'MXN', availability: 'https://schema.org/InStock', url: `${site.url}/#${p.id}` })),
};
---
<Base>
  <Hero />

  <Section id="arma" title="Arma tu zona en 3 pasos" lead="Responde tres preguntas y te decimos qué zona va con tu fiesta. Al final revisamos tu fecha por WhatsApp.">
    <ArmaTuZona />
  </Section>

  <Section id="paquetes" title="Elige tu zona" lead="Dos zonas pensadas para cada etapa. Cada una tiene su versión Pro, con cuidadoras que se quedan toda la fiesta.">
    {(['baby', 'terreneitor'] as const).map((f) => (
      <div class="family">
        <div class="family-head">
          <h3>{familias[f].nombre}</h3>
          <p>{familias[f].resumen}</p>
        </div>
        <div class="grid">{porFamilia(secos, f).map((p) => <PackageCard paquete={p} />)}</div>
      </div>
    ))}
  </Section>

  <Section id="incluye" title="Lo que llega a tu fiesta" lead="Todos los paquetes incluyen esto, sin costo extra.">
    <Incluye items={incluye} />
  </Section>

  <Section id="supervision" tone="sol">
    <div class="nanny">
      <div>
        <h2>Supervisión en los paquetes Pro</h2>
        <p class="sub">Nuestras cuidadoras se quedan las cinco horas en la zona de juego, para que tú puedas estar con tus invitados.</p>
        <ul class="rings">
          <li>Cuidan y organizan el juego dentro del área</li>
          <li>Pro Baby lleva dos cuidadoras; Terreneitor Pro, tres</li>
          <li>Nunca sacan a un niño del área ni dan alimentos</li>
        </ul>
      </div>
      <div class="nanny-card">
        <div class="big">2–3</div>
        <p>cuidadoras incluidas<br />en cada paquete Pro</p>
      </div>
    </div>
  </Section>

  <Section id="splash" tone="marino" title="Splash: juego con agua" lead="Las mismas zonas con mesa de agua, tapete fuente y alberca con patitos. Para los días de calor.">
    {(['baby', 'terreneitor'] as const).map((f) => (
      <div class="family">
        <div class="family-head"><h3>{familias[f].nombre} Splash</h3></div>
        <div class="grid">{porFamilia(splash, f).map((p) => <PackageCard paquete={p} />)}</div>
      </div>
    ))}
  </Section>

  <Section id="antes" title="Antes del evento" lead="Cuatro cosas que necesitamos del espacio para que el montaje salga perfecto y los niños jueguen seguros.">
    <Checks items={requisitos} />
  </Section>

  <Section id="como-funciona" tone="salvia" title="Cómo apartar tu fecha" lead="Todo se resuelve por WhatsApp en menos de un día.">
    <Steps items={pasos} />
  </Section>

  <Section id="semanas" title="Tu fiesta, semana a semana" lead="Una guía corta para llegar al día sin prisas.">
    <Steps items={semanas} />
  </Section>

  <Section id="preguntas" tone="frambuesa" title="Preguntas frecuentes">
    <Faq items={faq} />
  </Section>

  <Section id="cotiza" title="¿Apartamos tu fecha?" lead="Llena estos datos y te llega el mensaje listo en WhatsApp. También puedes escribirnos directo.">
    <QuoteForm />
    <p class="alt">
      <Button href={whatsappLink()} variant="text" icon="whatsapp" external>WhatsApp {site.phoneDisplay}</Button>
      <span aria-hidden="true">·</span>
      <Button href={`mailto:${site.email}`} variant="text" icon="correo">{site.email}</Button>
    </p>
  </Section>
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
</Base>

<style>
  .family + .family { margin-top: var(--space-8); }
  .family-head { display: flex; align-items: baseline; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-4); }
  .family-head h3 { font-size: var(--text-xl); }
  .family-head p { color: var(--color-text-muted); font-size: var(--text-sm); }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-5); }
  .nanny { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-8); align-items: center; }
  .sub { color: var(--color-text-muted); margin-top: var(--space-3); }
  .rings { list-style: none; margin-top: var(--space-5); }
  .rings li { padding: 6px 0 6px 22px; position: relative; }
  .rings li::before { content: ''; position: absolute; left: 0; top: 13px; width: 9px; height: 9px; border-radius: 50%; border: 2px solid var(--frambuesa-500); }
  .nanny-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-7); text-align: center; }
  .big { font-family: var(--font-display); font-size: 56px; font-weight: var(--weight-display); line-height: 1; color: var(--color-accent); }
  .nanny-card p { font-size: var(--text-sm); color: var(--color-text-muted); margin-top: var(--space-3); }
  .alt { margin-top: var(--space-5); display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; color: var(--color-text-muted); }
  @media (max-width: 820px) {
    .grid, .nanny { grid-template-columns: 1fr; }
    .nanny { gap: var(--space-6); }
  }
</style>
