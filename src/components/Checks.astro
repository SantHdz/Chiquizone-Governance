---
interface Props { items: { title: string; text: string }[] }
const { items } = Astro.props;
---
<div class="checks">
  {items.map((i) => <div class="check"><h3>{i.title}</h3><p>{i.text}</p></div>)}
</div>
<style>
  .checks { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6) var(--space-8); }
  .check { padding-left: 34px; position: relative; }
  .check::before {
    content: ''; position: absolute; left: 0; top: 5px; width: 18px; height: 10px;
    border-left: 1.6px solid var(--color-accent); border-bottom: 1.6px solid var(--color-accent); transform: rotate(-45deg);
  }
  h3 { font-size: var(--text-lg); margin-bottom: 3px; }
  p { font-size: var(--text-sm); color: var(--color-text-muted); }
  @media (max-width: 760px) { .checks { grid-template-columns: 1fr; } }
</style>
