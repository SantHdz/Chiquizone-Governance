---
import Icon from './Icon.astro';
interface Props { items: { title: string; text: string }[]; title?: string }
const { items, title } = Astro.props;
---
<aside class="checks">
  {title && <h3 class="t">{title}</h3>}
  <ul>
    {items.map((i, n) => <li data-reveal style={`--i:${n}`}><Icon name="listo" size={22} /><div><b>{i.title}</b><p>{i.text}</p></div></li>)}
  </ul>
</aside>
<style>
  .checks { background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); box-shadow: var(--shadow-card); }
  .t { font-size: var(--text-subtitle); margin-bottom: var(--space-4); }
  ul { list-style: none; display: grid; gap: var(--space-4); }
  li { display: grid; grid-template-columns: 22px 1fr; gap: var(--space-3); align-items: start; }
  li :global(.icon) { color: var(--success); margin-top: 2px; }
  b { display: block; font-weight: var(--weight-bold); }
  p { font-size: var(--text-sm); color: var(--color-text-muted); }
</style>
