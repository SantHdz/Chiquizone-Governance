---
/* Hilera de banderines a lo ancho. Patrón repetido, colores del logo. Decorativo. */
interface Props { class?: string; height?: number }
const { class: cls, height = 44, ...rest } = Astro.props;
---
<svg {...rest} class:list={['banderines', cls]} width="100%" height={height} viewBox="0 0 1200 44" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="cz-bandera" width="120" height="44" patternUnits="userSpaceOnUse">
      <path d="M0 6 Q 60 14 120 6" stroke="var(--marino-500)" stroke-width="2" fill="none" />
      <path d="M8 7 L 28 7 L 18 36 Z" fill="var(--frambuesa-500)" />
      <path d="M38 9 L 58 9 L 48 38 Z" fill="var(--sol-500)" />
      <path d="M68 9 L 88 9 L 78 38 Z" fill="var(--salvia-500)" />
      <path d="M98 7 L 118 7 L 108 36 Z" fill="var(--marino-500)" />
    </pattern>
  </defs>
  <rect width="1200" height="44" fill="url(#cz-bandera)" />
</svg>
<style>
  .banderines { display: block; }
</style>
