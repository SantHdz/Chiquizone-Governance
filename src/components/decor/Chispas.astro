---
/* Las tres chispas que acompañan a las caritas del logo. Acento junto a títulos. Decorativo. */
interface Props { class?: string; size?: number; color?: string }
const { class: cls, size = 28, color = 'var(--color-accent)', ...rest } = Astro.props;
---
<svg {...rest} class:list={['chispas', cls]} width={size} height={size} viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false" style={`color:${color}`}>
  <path d="M4 18 L 10 14" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
  <path d="M8 8 L 12 12" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
  <path d="M16 4 L 17 10" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
</svg>
<style>
  .chispas { display: inline-block; vertical-align: middle; }
</style>
