---
/*
 * Barra superior: enlaces a los lados y el logo al centro. En el inicio, el logo llega desde el titular
 * al hacer scroll (src/scripts/logo-viaje.ts); en las demás páginas está siempre en su lugar.
 */
import Button from './Button.astro';
import Logo from './Logo.astro';
import { whatsappLink } from '../data/site';

const izquierda = [
  { href: '/#arma', label: 'Arma tu zona' },
  { href: '/#paquetes', label: 'Paquetes' },
  { href: '/#incluye', label: 'Qué incluye' },
];
const derecha = [
  { href: '/#como-funciona', label: 'Cómo funciona' },
  { href: '/#preguntas', label: 'Preguntas' },
];
const todos = [...izquierda, ...derecha];
---
<header class="top">
  <nav class="wrap bar" aria-label="Principal">
    <button class="menu" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
      <span class="barras" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
    <ul class="links izq">{izquierda.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    <a class="brand" href="/" data-logo-dock aria-label="Chiquizone, inicio"><Logo /></a>
    <div class="der">
      <ul class="links">{derecha.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      <Button href={whatsappLink()} size="sm" icon="whatsapp" external>Cotiza</Button>
    </div>
  </nav>
  <div class="panel" id="menu">
    <ul>{todos.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  </div>
</header>

<script>
  const top = document.querySelector<HTMLElement>('header.top')!;
  const btn = top.querySelector<HTMLButtonElement>('.menu')!;
  const panel = top.querySelector<HTMLElement>('.panel')!;
  const abrir = (si: boolean) => {
    top.classList.toggle('open', si);
    btn.setAttribute('aria-expanded', String(si));
    btn.setAttribute('aria-label', si ? 'Cerrar menú' : 'Abrir menú');
  };
  btn.addEventListener('click', () => abrir(!top.classList.contains('open')));
  panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) abrir(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && top.classList.contains('open')) { abrir(false); btn.focus(); } });
  const alHacerScroll = () => top.classList.toggle('scrolled', window.scrollY > 8);
  alHacerScroll();
  addEventListener('scroll', alHacerScroll, { passive: true });
</script>

<style>
  .top {
    --barra: 76px;
    --marca: 58px; /* alto del logo ya acomodado en la barra */
    position: sticky; top: 0; z-index: 30;
    background: var(--color-bg);
    border-bottom: 1.5px solid transparent;
    transition: border-color var(--motion-state) var(--ease-standard), box-shadow var(--motion-state) var(--ease-standard);
  }
  .top.scrolled { border-color: var(--color-border); box-shadow: 0 6px 24px -18px rgb(23 40 81 / .35); }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; column-gap: var(--space-5); height: var(--barra); }
  .brand { grid-column: 2; display: block; width: calc(var(--marca) * 640 / 437); height: var(--marca); }
  .izq { grid-column: 1; justify-self: start; }
  .der { grid-column: 3; justify-self: end; display: flex; align-items: center; gap: var(--space-5); }
  .links { display: flex; gap: var(--space-5); list-style: none; }
  .links a {
    position: relative; text-decoration: none; font-size: var(--text-small); font-weight: var(--weight-bold); color: var(--color-text-muted);
    padding: 6px 2px; white-space: nowrap; transition: color var(--motion-hover) var(--ease-standard);
  }
  .links a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2.5px; border-radius: 2px; background: var(--color-accent);
    transform: scaleX(0); transform-origin: left; transition: transform var(--motion-state) var(--ease-standard);
  }
  .links a:hover { color: var(--color-text); }
  .links a:hover::after { transform: scaleX(1); }

  .menu { display: none; grid-column: 1; justify-self: start; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--color-border-strong); background: transparent; color: var(--color-text); cursor: pointer; place-items: center; }
  .barras { position: relative; display: block; width: 18px; height: 14px; }
  .barras i { position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px; background: currentColor; transition: transform var(--motion-state) var(--ease-standard), opacity var(--motion-hover) var(--ease-standard); }
  .barras i:nth-child(1) { top: 0; }
  .barras i:nth-child(2) { top: 6px; }
  .barras i:nth-child(3) { top: 12px; }
  .open .barras i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .open .barras i:nth-child(2) { opacity: 0; }
  .open .barras i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .panel { display: none; }

  /* Arriba del todo el logo grande es el protagonista: la barra se queda sin enlaces y estos aparecen
     cuando el logo llega a su lugar. Con el teclado siempre se pueden alcanzar. */
  :global(html.logo--hero) .izq, :global(html.logo--hero) .der { opacity: 0; pointer-events: none; }
  :global(html.logo--fly) .izq, :global(html.logo--fly) .der { opacity: var(--nav-o, 0); pointer-events: none; }
  .izq:focus-within, .der:focus-within { opacity: 1 !important; pointer-events: auto !important; }

  @media (max-width: 980px) {
    .top { --barra: 64px; --marca: 50px; }
    .izq, .der .links { display: none; }
    .menu { display: grid; }
    .open .panel { display: block; position: absolute; left: 0; right: 0; top: 100%; background: var(--color-bg); border-bottom: 1.5px solid var(--color-border); box-shadow: var(--shadow-raised); }
    .panel ul { list-style: none; padding: var(--space-3) var(--gutter) var(--space-4); }
    .panel a { display: block; padding: 12px 4px; text-decoration: none; font-size: var(--text-body-l); font-weight: var(--weight-medium); color: var(--color-text); }
  }
</style>
