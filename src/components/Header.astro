---
import Button from './Button.astro';
import { whatsappLink } from '../data/site';
const links = [
  { href: '/#paquetes', label: 'Paquetes' },
  { href: '/#splash', label: 'Splash' },
  { href: '/#como-funciona', label: 'Cómo funciona' },
  { href: '/#cotiza', label: 'Cotiza' },
];
---
<header class="top">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Chiquizone, inicio">CHIQUI ZONE</a>
    <nav aria-label="Principal">
      <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <Button href={whatsappLink()} size="sm" external>WhatsApp</Button>
  </div>
</header>

<style>
  .top {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .bar { display: flex; align-items: center; gap: var(--space-6); height: 64px; }
  .logo {
    font-family: var(--font-display); letter-spacing: var(--tracking-mark);
    font-size: var(--text-sm); color: var(--color-accent); text-decoration: none; white-space: nowrap;
  }
  nav { margin-left: auto; }
  ul { display: flex; gap: var(--space-5); list-style: none; }
  nav a { text-decoration: none; font-size: var(--text-sm); color: var(--color-text-muted); }
  nav a:hover { color: var(--color-text); }
  @media (max-width: 760px) {
    nav { display: none; }
    .bar :global(.btn) { margin-left: auto; }
  }
</style>
