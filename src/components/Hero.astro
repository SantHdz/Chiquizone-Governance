---
/*
 * Inicio: a la izquierda el titular y las dos llamadas a la acción; a la derecha el logo grande y la foto real
 * del montaje. El logo viaja a la barra al hacer scroll (src/scripts/logo-viaje.ts).
 * Los datos de precio, horas y espacio esperan su momento más abajo en la página.
 */
import Button from './Button.astro';
import Logo from './Logo.astro';
import Globos from './decor/Globos.astro';
import { whatsappLink } from '../data/site';
import { preguntasActivas } from '../data/paquetes';
---
<div class="hero">
  <div class="wrap grid">
    <div class="logo-slot" data-logo-slot>
      <div class="rise" data-reveal>
        <Logo class="hero-logo" label="Chiquizone" />
      </div>
    </div>

    <div class="copy">
      <p class="eyebrow" data-reveal style="--i:1">Zonas de juego para fiestas</p>
      <h1 data-reveal style="--i:2">La zona de juego que <em>crece</em> con tus hijos</h1>
      <p class="lede" data-reveal style="--i:3">Montamos, cuidamos y recogemos. Tú disfrutas la fiesta.</p>
      <div class="ctas" data-reveal style="--i:4">
        <Button href={whatsappLink()} size="lg" icon="whatsapp" external>Cotizar por WhatsApp</Button>
        {preguntasActivas > 0
          ? <Button href="#arma" variant="outline" size="md" iconRight="siguiente">Arma tu zona</Button>
          : <Button href="#paquetes" variant="outline" size="md" iconRight="siguiente">Ver la zona</Button>}
      </div>
    </div>

    <figure class="photo" data-reveal style="--i:3">
      <div class="frame">
        <img
          src="/fotos/montaje-jardin-1000.webp"
          srcset="/fotos/montaje-jardin-640.webp 640w, /fotos/montaje-jardin-1000.webp 1000w"
          sizes="(max-width: 900px) 92vw, 400px"
          width="1000" height="750"
          alt="Zona de juego Chiquizone montada en un jardín: corral de colores, brincolín, carritos y mesas infantiles."
          fetchpriority="high"
        />
      </div>
      <Globos class="globos" size={104} />
      <figcaption><span class="display">Montaje real</span></figcaption>
    </figure>
  </div>
</div>

<style>
  .hero { position: relative; padding: var(--space-6) 0 var(--space-9); overflow: clip; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    grid-template-areas: "copy logo" "copy photo";
    column-gap: var(--space-7);
    row-gap: var(--space-4);
    align-items: start;
  }

  /* El hueco conserva el tamaño del logo aunque viaje; el logo real y el que viaja miden lo mismo. */
  .logo-slot { grid-area: logo; justify-self: center; width: clamp(290px, 30vw, 400px); aspect-ratio: 640 / 437; }
  .hero-logo { --chispa-anim: chispa-in; }
  .js .rise[data-reveal] { transform: translateY(18px) scale(0.96); transition-duration: 800ms; }
  .js .rise[data-reveal].is-in { transform: none; }

  .copy { grid-area: copy; align-self: center; display: grid; gap: var(--space-5); justify-items: start; }
  /* 11ch: el titular termina antes de donde queda el logo ya en la barra (centro de la página) */
  h1 { font-size: clamp(42px, 5.2vw, 68px); max-width: 11ch; }
  .lede { font-size: var(--text-body-l); color: var(--color-text-muted); max-width: 34ch; }
  .ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center; margin-top: var(--space-2); }

  .photo { grid-area: photo; position: relative; margin: 0; justify-self: center; width: min(100%, 400px); }
  .frame {
    position: relative; border-radius: var(--radius-arch); overflow: hidden; aspect-ratio: 1 / 0.86;
    box-shadow: var(--shadow-raised);
    transform: rotate(1.5deg);
  }
  .frame img { width: 100%; height: 100%; object-fit: cover; object-position: 55% 62%; }
  .photo::before {
    /* bloque de color detrás, como un globo apoyado */
    content: ''; position: absolute; inset: 14px -14px -14px 14px; border-radius: var(--radius-arch);
    background: var(--sol-200); z-index: -1; transform: rotate(-2deg);
  }
  :global([data-theme="marino"]) .photo::before { background: var(--marino-700); }
  .globos { position: absolute; left: -52px; bottom: 44px; }
  figcaption {
    position: absolute; right: 18px; bottom: 18px; padding: 8px 14px; border-radius: var(--radius-pill);
    background: var(--surface-raised); color: var(--ink); font-size: var(--text-small); box-shadow: var(--shadow-card);
  }
  figcaption .display { color: var(--color-accent); }

  @media (max-width: 900px) {
    .hero { padding-top: var(--space-5); }
    .grid { grid-template-columns: 1fr; grid-template-areas: "logo" "copy" "photo"; row-gap: var(--space-6); }
    .logo-slot { width: min(74vw, 300px); }
    .copy { justify-items: center; text-align: center; }
    .copy :global(.eyebrow)::before { display: none; }
    h1 { max-width: 14ch; font-size: clamp(38px, 10.4vw, 54px); }
    .lede { max-width: 30ch; }
    .ctas { justify-content: center; }
    .photo { width: min(100%, 360px); margin-top: var(--space-3); }
    .globos { left: -20px; bottom: 30px; width: 86px; height: auto; }
  }
  @media (max-width: 480px) {
    .ctas :global(.btn) { width: 100%; }
  }
</style>
