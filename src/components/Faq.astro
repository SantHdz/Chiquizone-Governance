---
/* Preguntas frecuentes + datos estructurados FAQPage (benchmark, sección 5). */
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<div class="faq">
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <p>{i.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<style>
  .faq { max-width: 760px; border-top: 1.5px solid var(--color-border); }
  details { border-bottom: 1.5px solid var(--color-border); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    padding: var(--space-5) 0; font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-lg); color: var(--color-text);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: ''; flex: none; width: 12px; height: 12px; border-right: 2.5px solid var(--link); border-bottom: 2.5px solid var(--link);
    margin-top: -6px; transform: rotate(45deg); transition: transform var(--motion-state) var(--ease-standard), margin var(--motion-state) var(--ease-standard);
  }
  details[open] summary::after { margin-top: 6px; transform: rotate(-135deg); }
  summary:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 4px; border-radius: 4px; }
  details p { color: var(--color-text-muted); max-width: 62ch; padding-bottom: var(--space-5); }
  @media (prefers-reduced-motion: reduce) { summary::after { transition: none; } }
</style>
