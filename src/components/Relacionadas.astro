---
/* "Sigue leyendo": tarjetas con enlace a las demás páginas por tema. Son enlaces internos reales que Google y las IA siguen. */
import Icon from './Icon.astro';
import { temas } from '../data/seo';
interface Props { actual?: string }
const { actual } = Astro.props;
const lista = temas.filter((p) => p.ruta !== actual);
---
<ul class="rel">
  {lista.map((p, n) => (
    <li data-reveal style={`--i:${n}`}>
      <a href={p.ruta}>
        <span class="ico"><Icon name={p.icono} size={22} /></span>
        <h3>{p.nombre}</h3>
        <p>{p.resumen}</p>
      </a>
    </li>
  ))}
</ul>
<style>
  .rel { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  a { display: grid; gap: var(--space-2); align-content: start; height: 100%; padding: var(--space-5); text-decoration: none; background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); transition: transform var(--motion-state) var(--ease-standard), box-shadow var(--motion-state) var(--ease-standard); }
  a:hover { transform: translateY(-3px); box-shadow: var(--shadow-card); }
  .ico { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--sol-200); color: var(--marino-700); margin-bottom: var(--space-2); }
  h3 { font-size: var(--text-lg); color: var(--color-text); }
  p { font-size: var(--text-sm); color: var(--color-text-muted); }
  @media (max-width: 860px) { .rel { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .rel { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { a:hover { transform: none; } }
</style>
