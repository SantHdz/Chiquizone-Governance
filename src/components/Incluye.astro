---
/* "Qué incluye" en bloques Bento (benchmark: radiografía de la caja). Se cambia por la foto cenital numerada en la fase 2. */
import Icon from './Icon.astro';
interface Props { items: { icon: string; title: string; text: string; wide?: boolean }[] }
const { items } = Astro.props;
---
<ul class="bento">
  {items.map((i) => (
    <li class:list={{ wide: i.wide }}>
      <Icon name={i.icon} size={24} />
      <h3>{i.title}</h3>
      <p>{i.text}</p>
    </li>
  ))}
</ul>
<style>
  .bento { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
  li {
    background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg);
    padding: var(--space-5); display: grid; gap: var(--space-2); align-content: start;
  }
  li.wide { grid-column: span 2; background: var(--color-surface-alt); }
  li :global(.icon) { color: var(--link); margin-bottom: var(--space-2); }
  h3 { font-size: var(--text-lg); }
  p { font-size: var(--text-sm); color: var(--color-text-muted); }
  @media (max-width: 900px) { .bento { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .bento { grid-template-columns: 1fr; } li.wide { grid-column: auto; } }
</style>
