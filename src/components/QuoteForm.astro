---
import Button from './Button.astro';
import { publicados, unico } from '../data/paquetes';
import { site } from '../data/site';
---
<form class="quote" data-wa={site.whatsapp}>
  <label>Fecha del evento<input type="date" name="fecha" required /></label>
  <label>Hora de inicio<input type="time" name="hora" required /></label>
  <label class="full">Colonia y ciudad<input type="text" name="lugar" placeholder="Ej. Centro, Tequisquiapan" required /></label>
  <label class:list={{ full: unico }}>Edades de los niños<input type="text" name="edades" placeholder="Ej. 1, 3 y 5 años" required /></label>
  {unico ? (
    <input type="hidden" name="paquete" value={publicados[0].nombre} />
  ) : (
    <label>Paquete
      <select name="paquete">
        <option value="">Aún no sé, recomiéndenme</option>
        {publicados.map((p) => <option value={p.nombre}>{p.nombre}</option>)}
      </select>
    </label>
  )}
  <div class="full actions">
    <Button type="submit" icon="whatsapp">Enviar por WhatsApp</Button>
    <small>Se abre WhatsApp con tu mensaje listo. Te confirmamos disponibilidad el mismo día.</small>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('form.quote');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const fecha = String(d.get('fecha') || '');
    const fechaTxt = fecha
      ? new Date(fecha + 'T12:00').toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' })
      : '';
    const lines = [
      'Hola Chiquizone, quiero cotizar una zona de juego.',
      `Fecha: ${fechaTxt}`,
      `Hora de inicio: ${d.get('hora')}`,
      `Lugar: ${d.get('lugar')}`,
      `Edades: ${d.get('edades')}`,
      `Paquete: ${d.get('paquete') || 'Quiero recomendación'}`,
    ];
    const a = document.createElement('a');
    a.href = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
    a.target = '_blank';
    a.rel = 'noopener';
    a.click();
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
    btn?.setAttribute('aria-busy', 'true');
    setTimeout(() => btn?.removeAttribute('aria-busy'), 1200);
  });
</script>

<style>
  .quote {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4) var(--space-5);
    background: var(--color-surface); border: 1.5px solid var(--card-border); border-radius: var(--card-radius); box-shadow: var(--card-shadow);
    padding: var(--space-6); max-width: 720px;
  }
  label { display: flex; flex-direction: column; gap: 6px; font-size: var(--text-sm); font-weight: var(--weight-bold); color: var(--input-label); }
  .full { grid-column: 1 / -1; }
  input, select {
    font: inherit; font-weight: var(--weight-regular); font-size: var(--input-text); color: var(--input-fg);
    background: var(--input-bg); border: 1.5px solid var(--input-border); border-radius: var(--input-radius);
    padding: 0 var(--input-pad-x); height: var(--input-height); width: 100%;
    transition: border-color var(--motion-hover) var(--ease-standard), box-shadow var(--motion-hover) var(--ease-standard);
  }
  input::placeholder { color: var(--input-placeholder); }
  input:hover, select:hover { border-color: var(--ink-muted); }
  input:focus, select:focus { outline: none; border-color: var(--input-border-focus); box-shadow: 0 0 0 3px var(--marino-100); }
  input:user-invalid { border-color: var(--input-border-error); }
  .actions { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-2); }
  small { color: var(--color-text-muted); font-size: var(--text-xs); max-width: 36ch; }
  @media (max-width: 640px) { .quote { grid-template-columns: 1fr; padding: var(--space-5); } }
</style>
