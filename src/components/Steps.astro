---
interface Props { items: { title: string; text: string }[] }
const { items } = Astro.props;
---
<ol class="steps">
  {items.map((i) => <li><h3>{i.title}</h3><p>{i.text}</p></li>)}
</ol>
<style>
  .steps { list-style: none; counter-reset: s; max-width: var(--container-narrow); }
  li { counter-increment: s; padding: 0 0 26px 58px; position: relative; }
  li:not(:last-child)::after { content: ''; position: absolute; left: 17px; top: 36px; bottom: 2px; width: 1px; background: var(--color-border-strong); }
  li::before {
    content: counter(s); position: absolute; left: 0; top: 0; width: 35px; height: 35px; border-radius: 50%;
    border: 1px solid var(--color-accent); color: var(--color-accent); font-family: var(--font-display);
    display: grid; place-items: center; background: var(--color-bg);
  }
  h3 { font-size: var(--text-lg); margin-bottom: 2px; }
  p { font-size: var(--text-sm); color: var(--color-text-muted); }
</style>
