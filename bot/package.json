{
  "name": "chiquizone-asistente",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Asistente de WhatsApp de Chiquizone: cotiza, revisa la agenda y pasa la conversación a Sant.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "conocimiento": "node scripts/conocimiento.mjs",
    "check": "node scripts/conocimiento.mjs && git diff --exit-code -- src/conocimiento.generado.ts",
    "eval": "EVALS=1 vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.1"
  }
}
